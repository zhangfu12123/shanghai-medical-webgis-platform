# 服务配置
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# SQL Server 配置
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_DATABASE=PudongMedicalDB
DB_USER=webgis_app
DB_PASSWORD=请在本机.env中填写
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000

# JWT 配置（生产环境必须使用高强度随机值）
JWT_SECRET=请在本机.env中填写
JWT_EXPIRES_IN=2h
